{
  "name": "bdapi4all",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "data:bulk-expand": "tsx scripts/bulk-expand-encyclopedia.ts",
    "data:normalize": "tsx scripts/normalize-encyclopedia-data.ts",
    "data:bn-map": "tsx scripts/enrich-bengali-and-mapping.ts",
    "data:search-import": "tsx scripts/search-import-encyclopedia.ts",
    "data:seed-spices": "tsx scripts/seed-spices.ts",
    "data:quality": "tsx scripts/validate-data-quality.ts",
    "data:backfill-verified": "tsx scripts/backfill-verified.ts",
    "keys:issue": "tsx scripts/manage-keys.ts issue",
    "keys:list": "tsx scripts/manage-keys.ts list",
    "keys:revoke": "tsx scripts/manage-keys.ts revoke",
    "contract:validate": "tsx scripts/validate-contract.ts",
    "data:full-refresh": "npm run db:push && npm run db:seed && npm run data:seed-spices && npm run data:normalize && npm run data:bn-map && npm run data:quality",
    "test": "tsx --test tests/*.test.ts",
    "data:seed-postcodes": "tsx scripts/seed-postcodes.ts",
    "data:repair": "tsx scripts/repair-data.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.34.3",
    "adhan": "^4.4.6",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "16.14.2",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.15"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
